# ==============================================================================
# Spatial 3D Home & Asset Inventory — Environment Configuration Template
# ==============================================================================
# ATURAN KEAMANAN:
# 1. File ini HANYA template (.env.example). JANGAN PERNAH mengisi secret,
#    password, private key, atau signing certificate asli ke file yang di-commit.
# 2. Salin ke `.env` untuk lokal/server (`cp .env.example .env`) atau injeksikan
#    melalui Secret Manager (GitHub Secrets / Vault / KMS) di CI/CD & Production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
APP_NAME="Spatial 3D Home"
APP_ENV=demo                                # demo | staging | production
NODE_ENV=development                        # development | test | production
PORT=8080
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info                              # trace | debug | info | warn | error

# ------------------------------------------------------------------------------
# 2. Mobile App Identifiers & Simulator Feature Flags
# ------------------------------------------------------------------------------
APP_BUNDLE_ID_IOS=com.spatial3dhome.app
APP_PACKAGE_ID_ANDROID=com.spatial3dhome.app
APP_VERSION=1.0.0+1

# WAJIB false pada build production komersial untuk mencegah privilege escalation
ENABLE_DEMO_ROLE_SWITCHER=true
LIDAR_FALLBACK_SIMULATION=true
OFFLINE_ONLY_DEFAULT=true
SYNC_WIFI_ONLY_DEFAULT=true
AUTO_BLUR_PII_ON_DEVICE=true

# ------------------------------------------------------------------------------
# 3. Database (Backend PostgreSQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://spatial_user:CHANGE_ME_LOCAL_ONLY@localhost:5432/spatial_3d_home?sslmode=disable
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. Authentication, JWT & Session Security
# ------------------------------------------------------------------------------
# Minimal 32 karakter random hex/base64 di staging & production (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_32_CHARS_REFRESH_SECRET
JWT_ACCESS_TTL_SECONDS=900                  # 15 menit
JWT_REFRESH_TTL_SECONDS=2592000             # 30 hari
JWT_ISSUER=spatial-3d-home-api
JWT_AUDIENCE=spatial-3d-home-clients

# Argon2id Password Hashing Parameters
ARGON2_MEMORY_KB=65536                      # 64 MiB
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Biometric & Local Vault Policy (Mobile Client)
BIOMETRIC_IDLE_TIMEOUT_SECONDS=300          # 5 menit idle -> wajib FaceID/TouchID/PIN
MAX_FAILED_UNLOCK_ATTEMPTS=10
LOCAL_ENCRYPTION_ALGO=AES-256-GCM
STORAGE_ENCRYPTION_KEY_REF=secure_enclave://com.spatial3dhome.app/vault_master_key

# ------------------------------------------------------------------------------
# 5. CORS, Rate Limiting & Transport Security
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://webui.5nod.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=15
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 6. Sync Server, Storage & Share Link Configuration
# ------------------------------------------------------------------------------
# Pada mode simulator offline murni, set API_BASE_URL=local
API_BASE_URL=http://localhost:8080/api/v1
SYNC_SERVER_BASE_URL=http://localhost:8080/api/v1
SHARE_LINK_BASE_URL=https://view.spatialhome.example/s
SHARE_LINK_DEFAULT_TTL_HOURS=72
SHARE_LINK_MAX_TTL_HOURS=2160               # 90 hari
PDF_HASH_SALT_MODE=SHA256-DEVICE-SIGN

# Object Storage (Encrypted Blob Sync: S3 / MinIO / Local Disk Sandbox)
STORAGE_DRIVER=local                        # local | s3
STORAGE_LOCAL_PATH=./storage/encrypted_blobs
S3_ENDPOINT=
S3_BUCKET=spatial-3d-home-blobs
S3_REGION=ap-southeast-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_ROOM_MESH_SIZE_MB=20
MAX_ASSET_PHOTO_SIZE_MB=10

# ------------------------------------------------------------------------------
# 7. Domain Business Defaults (Valuation & Currency)
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=IDR                        # IDR | USD
DEPRECIATION_RATE_ELECTRONICS=0.20          # 20% per tahun, salvage floor 10%
DEPRECIATION_FLOOR_ELECTRONICS=0.10
DEPRECIATION_RATE_FURNITURE=0.10            # 10% per tahun, salvage floor 20%
DEPRECIATION_FLOOR_FURNITURE=0.20
DEPRECIATION_RATE_COLLECTIBLES=0.00         # 0% default (appreciation/manual appraisal)
WARRANTY_EXPIRING_SOON_DAYS=30

# ------------------------------------------------------------------------------
# 8. Optional External Integrations (B2B Insurance / Notifications)
# ------------------------------------------------------------------------------
B2B_INSURANCE_WEBHOOK_URL=
B2B_INSURANCE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@spatialhome.example
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_TOKEN=

# ------------------------------------------------------------------------------
# 9. Mobile CI/CD Build Pipeline (GitHub Actions Secrets — JANGAN isi di Git)
# ------------------------------------------------------------------------------
IOS_TEAM_ID=
IOS_PROVISIONING_PROFILE_NAME=
IOS_SIGN_MODE=unsigned-sideload             # unsigned-sideload | ad-hoc | app-store
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
